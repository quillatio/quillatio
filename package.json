{
  "name": "quillatio",
  "version": "0.1.0",
  "description": "Opt-in coding agent recording to managed Laminar",
  "type": "module",
  "bin": {
    "quillatio": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/hook.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run tests/",
    "prepack": "npm run build",
    "lint": "oxlint --deny-warnings src tests"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
